# VALORA Environment Variables
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=VALORA
APP_VERSION=1.0.0

# Database
POSTGRES_USER=valora
POSTGRES_PASSWORD=valora_secret_change_me
POSTGRES_DB=valora
DATABASE_URL=postgresql://valora:valora_secret_change_me@localhost:5432/valora

# Redis
REDIS_PASSWORD=valora_redis_change_me
REDIS_URL=redis://:valora_redis_change_me@localhost:6379/0

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq LLM API
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# API Configuration
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simulation Defaults
DEFAULT_CONSUMERS=1000
DEFAULT_FIRMS=200
DEFAULT_BANKS=20
DEFAULT_SIMULATION_TICKS=100

# Blockchain
BLOCKCHAIN_DIFFICULTY=4
EVENTS_PER_BLOCK=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Celery
CELERY_BROKER_URL=redis://:valora_redis_change_me@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:valora_redis_change_me@localhost:6379/2
